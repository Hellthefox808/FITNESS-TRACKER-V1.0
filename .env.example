# Application Settings
PROJECT_NAME="FitAI Machine Learning Engine"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Security Secrets (In production, replace with secure random string: `openssl rand -hex 32`)
SECRET_KEY="development_secret_key_change_in_production_environment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL 15)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/fitness_tracker_db"

# Redis Cache & Rate Limiter
REDIS_URL="redis://localhost:6379/0"

# CORS Whitelist (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ML Model Artifact Path
ML_MODEL_PATH="./src/ml/models/xgb_calorie_v1.pkl"
